# Copy this file to ".env" and adjust as needed.

# Database — Neon PostgreSQL connection string (used for dev and production)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Where the Python FastAPI ML service is running
# Local: http://127.0.0.1:8000   Production: your Render URL
ML_API_URL="http://127.0.0.1:8000"

# Secret used to sign JWT session cookies — CHANGE THIS to a long random string
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
